datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plan {
  id         String   @id @default(cuid())
  taken      String   // JSON stringified array
  inProgress String   // JSON stringified array
  planned    String   // JSON stringified array
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
